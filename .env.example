# Synthetic local reference settings only. Never place student data or real secrets here.
NODE_ENV=development
CAMPMIND_DATA_BACKEND=json
CAMPMIND_DEMO_MFA=true
CAMPMIND_MASTER_KEY=
# Optional comma-separated previous keys during a bounded rotation window;
# inject from a secret manager and remove after re-encryption is verified.
CAMPMIND_PREVIOUS_MASTER_KEYS=
CAMPMIND_DATA_FILE=private-data/demo-store.json
CAMPMIND_OBJECTS_DIR=private-data/objects
CAMPMIND_ALLOWED_ORIGINS=http://localhost:8787
# Provisional local-only workflow targets (calendar hours; not a service guarantee).
CAMPMIND_CASE_SLA_REVIEW_HOURS=24
CAMPMIND_CASE_SLA_ASSIGNMENT_HOURS=24
CAMPMIND_CASE_SLA_ACK_HOURS=4
CAMPMIND_CASE_SLA_FOLLOW_UP_HOURS=24
CAMPMIND_CASE_SLA_CLOSURE_REVIEW_HOURS=24
# Optional fixed school year for a controlled deployment; self-screening
# requests are server-bound to this value and cannot choose another year.
# CAMPMIND_ACADEMIC_YEAR=2026-2027

# Production is intentionally fail-closed until real adapters and evidence exist:
# NODE_ENV=production
# CAMPMIND_DATA_BACKEND=postgres
# CAMPMIND_POSTGRES_ADAPTER_READY=true
# CAMPMIND_POSTGRES_URL=<inject from a secret manager; never commit>
# CAMPMIND_POSTGRES_SSL=true
# CAMPMIND_POSTGRES_SSL_REJECT_UNAUTHORIZED=true
# CAMPMIND_POSTGRES_POOL_MAX=10
# CAMPMIND_OBJECT_STORE_ADAPTER_READY=true
# CAMPMIND_DEMO_MFA=false
# CAMPMIND_REGIONAL_ANALYTICS_APPROVED=false
# CAMPMIND_MEDIA_SCANNER_READY=false
# CAMPMIND_NOTIFICATION_ADAPTER_READY=false
# Appointment waiting-time exception threshold in minutes (15–10080; default 1440).
CAMPMIND_APPOINTMENT_CONFIRMATION_SLA_MINUTES=1440
# Configure all CAMPMIND_CASE_SLA_*_HOURS values only after school approval;
# missing production targets deliberately place open cases in the exception queue.
# CAMPMIND_EXPRESSION_ENABLED=false
# CAMPMIND_VISUAL_DEPLOYMENT_ENABLED=false
# CAMPMIND_EXPRESSION_GOVERNANCE_EVIDENCE=false
# CAMPMIND_EXPRESSION_PRIVACY_EVIDENCE=false
# CAMPMIND_EXPRESSION_FLOW_EVIDENCE=false
# CAMPMIND_EXPRESSION_OPS_EVIDENCE=false
# CAMPMIND_EXPRESSION_VISUAL_EVIDENCE=false
# CAMPMIND_MASTER_KEY=<inject from a secret manager; do not commit>
